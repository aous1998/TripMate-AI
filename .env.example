# .env.example - template for your own settings.
# Copy it to a file named .env (which git ignores) and fill in real values.
# backend.py and mcp_server.py read .env at startup with python-dotenv.

# PostgreSQL connection string: stores conversations and paused reviews (required).
# For Supabase use the "Session pooler" string from Connect -> Connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/travel_db
# Groq API key for the LLM (required), from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
# Groq model name (optional; change it if Groq retires this model).
GROQ_MODEL=openai/gpt-oss-120b
# AviationStack key for live flights (without it, only flight search fails).
AVIATIONSTACK_API_KEY=your_aviationstack_api_key
# Tavily key for web search: hotels and local tips (without it, only web search fails).
TAVILY_API_KEY=your_tavily_api_key
# Airport used as the origin when a request names only a destination.
DEFAULT_ORIGIN_IATA=FRA

# Optional extras (remove the leading "# " to use them):
# USE_MCP=false              -> call the tools in-process instead of via the MCP server
# TEST_DATABASE_URL=...      -> a separate database for the PostgreSQL tests in tests/
