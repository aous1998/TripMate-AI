   "width": 269.5,
   "height": 210.0,
   "text": "API contract\n\nPOST /api/travel\n{message, thread_id?, human_review}\n\nPOST /api/travel/review\n{thread_id, approved, feedback?}\n\nreply: status needs_review\n  {review: flights, hotels, trip}\nor status done {answer, budget,\n  agents_run, guardrail, ...}",
