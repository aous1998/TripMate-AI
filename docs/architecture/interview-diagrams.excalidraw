   "id": "ivnt352",
   "x": 1470.25,
   "y": 2384.375,
   "width": 379.50000000000006,
   "height": 131.25,
   "text": "Measured (fake LLM and APIs, n=20 runs):\n- app overhead per full trip: median 25 ms\n  with in-memory state\n- with local PostgreSQL: median 80 ms\n  (p95 121 ms): saving state costs about 55 ms\n- MCP tool call overhead: about 3 ms\n- LLM calls per full trip: 5",
   "originalText": "Measured (fake LLM and APIs, n=20 runs):\n- app overhead per full trip: median 25 ms\n  with in-memory state\n- with local PostgreSQL: median 80 ms\n  (p95 121 ms): saving state costs about 55 ms\n- MCP tool call overhead: about 3 ms\n- LLM calls per full trip: 5",
   "fontSize": 15,
   "fontFamily": 1,
   "lineHeight": 1.25,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "ivr185",
   "autoResize": true
  },
