   "locked": false,
   "type": "text",
   "id": "nt261",
   "x": 1390,
   "y": 1830,
   "width": 422.40000000000003,
   "height": 80.0,
   "text": "Add a 7th agent in 4 places: agents/<name>.py,\nSPECIALISTS (workflow.py), AgentName +\nAGENT_ORDER (state.py), and the agent list\nin the supervisor prompt (agents/supervisor.py).",
   "originalText": "Add a 7th agent in 4 places: agents/<name>.py,\nSPECIALISTS (workflow.py), AgentName +\nAGENT_ORDER (state.py), and the agent list\nin the supervisor prompt (agents/supervisor.py).",
   "fontSize": 16,
   "fontFamily": 1,
   "lineHeight": 1.25,
