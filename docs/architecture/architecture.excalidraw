   "width": 475.20000000000005,
   "height": 112.5,
   "text": "Run:   copy .env.example .env   (add your keys)\n       pip install -r requirements.txt\n       python app.py   ->  http://127.0.0.1:8000\nTest:  pip install -r requirements-dev.txt\n       python -m pytest",
   "originalText": "Run:   copy .env.example .env   (add your keys)\n       pip install -r requirements.txt\n       python app.py   ->  http://127.0.0.1:8000\nTest:  pip install -r requirements-dev.txt\n       python -m pytest",
   "fontSize": 18,
   "fontFamily": 1,
