   "id": "nt189",
   "x": 50,
   "y": 258,
   "width": 326.70000000000005,
   "height": 27.5,
   "text": "Read the code in this order",
   "originalText": "Read the code in this order",
   "fontSize": 22,
   "fontFamily": 1,
   "lineHeight": 1.25,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true
  },
  {
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1796035740,
   "version": 1,
   "versionNonce": 300026768,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "type": "text",
   "id": "nt190",
   "x": 50,
   "y": 300,
   "width": 544.5,
   "height": 180.0,
   "text": "1  app.py - HTTP routes /api/travel, /api/travel/review\n2  backend.py - DB connection, run / resume, JSON reply\n3  workflow.py - every graph node and edge\n4  state.py - shared state + typed schemas\n5  agents/supervisor.py - plans, then routes\n6  agents/review.py - the human-approval pause\n7  agents/guardrails.py - input and output checks\n8  tools/mcp_client.py + mcp_server.py - tool calls",
   "originalText": "1  app.py - HTTP routes /api/travel, /api/travel/review\n2  backend.py - DB connection, run / resume, JSON reply\n3  workflow.py - every graph node and edge\n4  state.py - shared state + typed schemas\n5  agents/supervisor.py - plans, then routes\n6  agents/review.py - the human-approval pause\n7  agents/guardrails.py - input and output checks\n8  tools/mcp_client.py + mcp_server.py - tool calls",
   "fontSize": 18,
   "fontFamily": 1,
   "lineHeight": 1.25,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true
  },
